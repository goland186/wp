# ============================================================
# Конфигурация развёртывания caranddriver.ru
# Скопируйте:  cp config.env.sample config.env
# Заполните 5 значений с <<< — остальное можно не трогать.
# Запуск:  bash run-migration.sh config.env
# ============================================================

# --- Куда ставим сайт (обязательно) ---
SITE_DIR="/var/www/caranddriver.ru"        # <<< корень сайта на новом сервере

# --- База данных (обязательно) — НОВАЯ пустая база ---
DB_NAME="wp_cdr"                           # <<< имя БД
DB_USER="wp_cdr"                           # <<< пользователь БД
DB_PASS="СЛОЖНЫЙ_ПАРОЛЬ"                   # <<< пароль БД
DB_HOST="localhost"

# --- Домены ---
# Старый домен (в дампе) — менять не нужно:
DOMAIN="caranddriver.ru"
# Целевой домен. Оставьте ПУСТЫМ, если сайт открывается на том же домене.
# Если разворачиваете сначала на тестовом поддомене, впишите его —
# скрипт выполнит замену URL по всей базе (wp search-replace):
NEW_DOMAIN=""

# --- Префикс таблиц ---
# НЕ МЕНЯТЬ: таблицы старого дампа используют префикс wpla_
DB_PREFIX="wpla_"

# --- Папка uploads (для второго запуска: run-migration.sh config.env uploads) ---
# Путь на ЭТОМ сервере к папке uploads (скопированной со старого сервера)
# ИЛИ к архиву uploads.tar.gz / uploads.zip:
UPLOADS_SRC="/root/uploads.tar.gz"

# --- Уведомления в Telegram (необязательно, можно оставить пустым) ---
TG_TOKEN=""
TG_CHAT_ID=""
